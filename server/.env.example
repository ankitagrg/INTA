MONGO_URI=mongodb://127.0.0.1:27017/inta
# Or use MongoDB Atlas connection string:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/inta
JWT_SECRET=replace_this_with_a_long_random_string
JWT_REFRESH_SECRET=replace_this_with_a_different_long_random_string
PORT=5000
CLIENT_URL=http://localhost:5173
# From Google Cloud Console > APIs & Services > Credentials > OAuth Client ID (Web application)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
